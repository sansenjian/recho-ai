{
  "name": "recho-ai-gateway",
  "version": "1.0.0",
  "description": "API gateway for AI chat aggregation",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "credits:create": "tsx src/scripts/create-credit-codes.ts",
    "normalize:image-prompts": "tsx src/scripts/normalize-image-prompts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.107.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "openai": "^7.22.0",
    "sharp": "^0.35.4",
    "undici": "^8.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.22.1",
    "typescript": "^7.0.2"
  }
}
